# Copy this file to .env and fill in the values. .env is git-ignored.

# GitHub user whose public repositories are listed on the site
VITE_GITHUB_USER=raulacor

# Supabase (Project Settings → API). The anon key is public by design; RLS protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Formspree form id (the part after https://formspree.io/f/)
VITE_FORMSPREE_ID=your-form-id
